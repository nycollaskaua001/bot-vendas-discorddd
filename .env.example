# Bot de Vendas Discord - Variáveis de Ambiente

# Token do bot Discord
DISCORD_TOKEN=seu_token_aqui

# ID do servidor Discord (guild)
GUILD_ID=seu_guild_id_aqui

# ID do canal de log
LOG_CHANNEL_ID=seu_canal_id_aqui

# ID do criador/admin
OWNER_ID=seu_user_id_aqui

# Chave PIX do recebedor (pode ser CPF, Email, Telefone ou Chave Aleatória)
PIX_KEY=sua_chave_pix_aqui

# Nome do recebedor (para o QR Code)
RECEIVER_NAME=Seu Nome

# Caminho para a imagem do banner (opcional)
BANNER_PATH=assets/banner.png

# Caminho para o QR Code customizado (opcional)
QRCODE_PATH=assets/qrcode.png

# Bancos proibidos (separados por vírgula)
BLOCKED_BANKS=Banco1,Banco2,Banco3
